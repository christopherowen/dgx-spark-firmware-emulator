+/* GPIO configuration/readback model. External pins and interrupts are not modeled. */
+static uint64_t spark_gpio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint32_t *registers = opaque;
+    return registers[addr >> 4];
+}
+
+static void spark_gpio_write(void *opaque, hwaddr addr, uint64_t value,
+                                  unsigned size)
+{
+    uint32_t *registers = opaque;
+    switch (addr & 0xf) {
+    case 0:
+        registers[addr >> 4] = value;
+        break;
+    case 4:
+        registers[addr >> 4] |= value;
+        break;
+    case 8:
+        registers[addr >> 4] &= ~value;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "spark GPIO: unsupported write at offset 0x%" HWADDR_PRIx "\n", addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps spark_gpio_ops = {
+    .read = spark_gpio_read,
+    .write = spark_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/*
+ * MT8901 EINT configuration and software pending interrupts. Register offsets
+ * follow NVIDIA NV-Kernels mtk-eint.c; external pin input and debounce timing
+ * are not modeled. The four bank bases and parent GSI 563 come from Spark ACPI.
+ */
+static void spark_eint_update(VirtMachineState *vms)
+{
+    bool pending = false;
+    for (unsigned bank = 0; bank < 4; bank++) {
+        uint32_t *r = vms->spark_eint[bank];
+        for (unsigned port = 0; port < 16; port++) {
+            pending |= !!(r[port] & ~r[0x80 / 4 + port] &
+                          r[0x400 / 4 + port]);
+        }
+    }
+    if (vms->spark_eint_irq) {
+        qemu_set_irq(vms->spark_eint_irq, pending);
+    }
+}
+
+static uint64_t spark_eint_read(void *opaque, hwaddr addr, unsigned size)
+{
+    VirtMachineState *vms = opaque;
+    return vms->spark_eint[addr / 0x1000][(addr & 0xfff) / 4];
+}
+
+static void spark_eint_write(void *opaque, hwaddr addr, uint64_t value,
+                             unsigned size)
+{
+    VirtMachineState *vms = opaque;
+    uint32_t *r = vms->spark_eint[addr / 0x1000];
+    unsigned offset = addr & 0xfff;
+    unsigned port = (offset & 0x3f) / 4;
+    unsigned target;
+    switch (offset & ~0x3f) {
+    case 0x40: /* acknowledge pending bits */
+        r[port] &= ~value;
+        break;
+    case 0x80: case 0x140: case 0x300: case 0x400:
+        r[offset / 4] = value;
+        break;
+    case 0xc0: case 0x180: case 0x340: /* SET aliases */
+        r[(offset - 0x40) / 4] |= value;
+        break;
+    case 0x100: case 0x1c0: case 0x380: /* CLEAR aliases */
+        r[(offset - 0x80) / 4] &= ~value;
+        break;
+    case 0x200: /* software pending, no external inputs */
+        r[offset / 4] = value;
+        r[port] = value;
+        break;
+    case 0x240:
+        r[(offset - 0x40) / 4] |= value;
+        r[port] |= value;
+        break;
+    case 0x280:
+        r[(offset - 0x80) / 4] &= ~value;
+        r[port] &= ~value;
+        break;
+    default:
+        target = (0x500 + (offset & 0xff)) / 4;
+        switch (offset & 0xf00) {
+        case 0x500: /* debounce configuration only, no timing effect */
+            r[target] = value;
+            break;
+        case 0x600:
+            r[target] |= value;
+            break;
+        case 0x700:
+            r[target] &= ~value;
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP, "spark EINT: unsupported write at 0x%"
+                          HWADDR_PRIx "\n", addr);
+            break;
+        }
+        break;
+    }
+    spark_eint_update(vms);
+}
+
+static const MemoryRegionOps spark_eint_ops = {
+    .read = spark_eint_read,
+    .write = spark_eint_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/*
+ * Polled transport inferred from the UEFI driver. This opt-in failure scenario
+ * returns a nonzero service status; it does not implement or authenticate ROT
+ * firmware, and must never be presented as a successful security service.
+ */
+static uint64_t spark_rot_read(void *opaque, hwaddr addr, unsigned size)
+{
+    SparkRotMailbox *m = opaque;
+    switch (addr) {
+    case 0x20: /* transmit FIFO ready */
+        return 1;
+    case 0x40: /* receive FIFO */
+        if (m->reply_pending && !m->reply_consumed) {
+            m->reply_consumed = true;
+            return m->reply;
+        }
+        return 0;
+    case 0x50:
+        return m->reply_pending;
+    case 0x70: /* acknowledgement data, unused by the observed driver */
+        return 0;
+    case 0x80:
+        return m->ack_pending;
+    case 0xb0: /* transport error flags */
+        return 0;
+    default:
+        qemu_log_mask(LOG_UNIMP, "spark ROT: unsupported read at 0x%"
+                      HWADDR_PRIx "\n", addr);
+        return 0;
+    }
+}
+
+static void spark_rot_write(void *opaque, hwaddr addr, uint64_t value,
+                            unsigned size)
+{
+    SparkRotMailbox *m = opaque;
+    switch (addr) {
+    case 0x10: /* transmit FIFO */
+        if (m->tx_count < ARRAY_SIZE(m->tx)) {
+            m->tx[m->tx_count++] = value;
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "spark ROT: transmit FIFO overflow\n");
+        }
+        break;
+    case 0x30:
+        if (value == 3) { /* observed transport initialization */
+            m->tx_count = 0;
+            m->reply_pending = m->ack_pending = false;
+            m->reply_consumed = false;
+        } else if (value == 1 && m->tx_count) {
+            /* Echo message ID, zero data words, nonzero service status (1). */
+            m->reply = (m->tx[0] & 0xff) | (1 << 12);
+            m->reply_pending = m->ack_pending = true;
+            m->reply_consumed = false;
+            qemu_log_mask(LOG_UNIMP,
+                          "spark ROT: service 0x%x unavailable; explicit error reply\n",
+                          m->tx[0] & 0xff);
+            m->tx_count = 0;
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "spark ROT: invalid doorbell/FIFO state\n");
+        }
+        break;
+    case 0x60: /* receive status W1C */
+        if (value & 1) {
+            m->reply_pending = false;
+        }
+        break;
+    case 0x90: /* acknowledgement status W1C */
+        if (value & 1) {
+            m->ack_pending = false;
+        }
+        break;
+    case 0xc0: /* observed initialization clears stale indications */
+        m->reply_pending = m->ack_pending = false;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "spark ROT: unsupported write at 0x%"
+                      HWADDR_PRIx "\n", addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps spark_rot_ops = {
+    .read = spark_rot_read,
+    .write = spark_rot_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
