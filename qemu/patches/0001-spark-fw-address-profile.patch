+static uint64_t spark_usb_ippc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint32_t *r = opaque;
+    if (addr == 0x10) {
+        return ((r[0] | r[1]) & 1) ? 0 : 0x10d01;
+    }
+    if (addr == 0x24) {
+        return 0x101; /* one USB2 and one USB3 port */
+    }
+    return r[addr / 4];
+}
+
+static const MemoryRegionOps spark_usb_ippc_ops = {
+    .read = spark_usb_ippc_read, .write = spark_usb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+    .impl.min_access_size = 4, .impl.max_access_size = 4,
+};
+
+static uint64_t spark_pcie_config_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint8_t *r = opaque;
+    uint64_t value = 0;
+    for (unsigned i = 0; i < size; i++) {
+        value |= (uint64_t)r[addr + i] << (8 * i);
+    }
+    return value;
+}
+
+static void spark_pcie_config_write(void *opaque, hwaddr addr, uint64_t value,
+                                    unsigned size)
+{
+    uint8_t *r = opaque;
+    for (unsigned i = 0; i < size; i++) {
+        r[addr + i] = value >> (8 * i);
+    }
+}
+
+static const MemoryRegionOps spark_pcie_config_ops = {
+    .read = spark_pcie_config_read, .write = spark_pcie_config_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1, .valid.max_access_size = 4,
+    .impl.min_access_size = 1, .impl.max_access_size = 4,
+    .valid.unaligned = true, .impl.unaligned = true,
+};
+
+static uint64_t spark_ecam_read(void *opaque, hwaddr addr, unsigned size)
+{
+    VirtMachineState *vms = opaque;
+    unsigned segment = addr >> 28;
+    hwaddr offset = addr & 0xfffffff;
+    /* Minimal lab bridge: segment 0, bus 1, slot 0 -> GPEX slot 1.
+     * Conventional NIC configuration is 256 bytes; extended accesses must
+     * not spill into another GPEX devfn through pci_data_read/write.
+     */
+    if (segment == 0 && vms->bus && offset >= 0x100000 &&
+        offset + size <= 0x100100) {
+        return pci_data_read(vms->bus, 8 * 256 + (offset & 255), size);
+    }
+    if (offset + size > 4096) {
+        return UINT64_MAX;
+    }
+    uint64_t value = spark_pcie_config_read(vms->spark_root_config[segment],
+                                            offset, size);
+    if (segment == 0 && vms->bus && pci_find_device(vms->bus, 0, 8)) {
+        for (unsigned i = 0; i < size; i++) {
+            if (offset + i == 0x52 || offset + i == 0x53) {
+                unsigned byte = offset + i == 0x52 ? 0x11 : 0x20;
+                value = (value & ~(0xffULL << (i * 8))) |
+                        ((uint64_t)byte << (i * 8));
+            }
+        }
+    }
+    return value;
+}
+
+static void spark_ecam_write(void *opaque, hwaddr addr, uint64_t value,
+                             unsigned size)
+{
+    VirtMachineState *vms = opaque;
+    unsigned segment = addr >> 28;
+    hwaddr offset = addr & 0xfffffff;
+    if (segment == 0 && vms->bus && offset >= 0x100000 &&
+        offset + size <= 0x100100) {
+        pci_data_write(vms->bus, 8 * 256 + (offset & 255), value, size);
+        return;
+    }
+    if (offset + size > 4096 || offset < 4 ||
+        (offset >= 8 && offset < 0x10) ||
+        (offset >= 0x10 && offset < 0x18) ||
+        (offset >= 0x30 && offset < 0x40) || offset >= 0x40) {
+        return;
+    }
+    spark_pcie_config_write(vms->spark_root_config[segment], offset, value, size);
+}
+
+static const MemoryRegionOps spark_ecam_ops = {
+    .read = spark_ecam_read, .write = spark_ecam_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1, .valid.max_access_size = 4,
+    .impl.min_access_size = 1, .impl.max_access_size = 4,
+};
