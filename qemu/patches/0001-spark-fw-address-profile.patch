+/*
+ * Polled transport inferred from the UEFI driver. This opt-in failure scenario
+ * returns a nonzero service status; it does not implement or authenticate ROT
+ * firmware, and must never be presented as a successful security service.
+ */
+static uint64_t spark_rot_read(void *opaque, hwaddr addr, unsigned size)
+{
+    SparkRotMailbox *m = opaque;
+    switch (addr) {
+    case 0x20: /* transmit FIFO ready */
+        return 1;
+    case 0x40: /* receive FIFO */
+        if (m->reply_pending && !m->reply_consumed) {
+            m->reply_consumed = true;
+            return m->reply;
+        }
+        return 0;
+    case 0x50:
+        return m->reply_pending;
+    case 0x70: /* acknowledgement data, unused by the observed driver */
+        return 0;
+    case 0x80:
+        return m->ack_pending;
+    case 0xb0: /* transport error flags */
+        return 0;
+    default:
+        qemu_log_mask(LOG_UNIMP, "spark ROT: unsupported read at 0x%"
+                      HWADDR_PRIx "\n", addr);
+        return 0;
+    }
+}
+
+static void spark_rot_write(void *opaque, hwaddr addr, uint64_t value,
+                            unsigned size)
+{
+    SparkRotMailbox *m = opaque;
+    switch (addr) {
+    case 0x10: /* transmit FIFO */
+        if (m->tx_count < ARRAY_SIZE(m->tx)) {
+            m->tx[m->tx_count++] = value;
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "spark ROT: transmit FIFO overflow\n");
+        }
+        break;
+    case 0x30:
+        if (value == 3) { /* observed transport initialization */
+            m->tx_count = 0;
+            m->reply_pending = m->ack_pending = false;
+            m->reply_consumed = false;
+        } else if (value == 1 && m->tx_count) {
+            /* Echo message ID, zero data words, nonzero service status (1). */
+            m->reply = (m->tx[0] & 0xff) | (1 << 12);
+            m->reply_pending = m->ack_pending = true;
+            m->reply_consumed = false;
+            qemu_log_mask(LOG_UNIMP,
+                          "spark ROT: service 0x%x unavailable; explicit error reply\n",
+                          m->tx[0] & 0xff);
+            m->tx_count = 0;
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "spark ROT: invalid doorbell/FIFO state\n");
+        }
+        break;
+    case 0x60: /* receive status W1C */
+        if (value & 1) {
+            m->reply_pending = false;
+        }
+        break;
+    case 0x90: /* acknowledgement status W1C */
+        if (value & 1) {
+            m->ack_pending = false;
+        }
+        break;
+    case 0xc0: /* observed initialization clears stale indications */
+        m->reply_pending = m->ack_pending = false;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "spark ROT: unsupported write at 0x%"
+                      HWADDR_PRIx "\n", addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps spark_rot_ops = {
+    .read = spark_rot_read,
+    .write = spark_rot_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
